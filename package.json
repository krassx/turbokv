{
  "name": "turbokv",
  "version": "0.1.0",
  "description": "Layered in-memory KV cache for Node.js clusters: per-process L1 with a byte budget over a shared-memory L2 the primary owns and workers map read-only.",
  "license": "MIT",
  "author": "Alexey Karimov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krassx/turbokv.git"
  },
  "homepage": "https://github.com/krassx/turbokv#readme",
  "bugs": {
    "url": "https://github.com/krassx/turbokv/issues"
  },
  "keywords": [
    "cache",
    "shared-memory",
    "cluster",
    "ipc",
    "lru",
    "native",
    "napi"
  ],
  "type": "commonjs",
  "main": "./index.js",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.ts",
        "default": "./index.js"
      },
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "prebuilds/",
    "index.js",
    "index.mjs",
    "index.d.ts",
    "index.d.mts",
    "src/turbokv.js",
    "src/fastpath.js",
    "src/l3/",
    "src/native.js",
    "src/binding.cc",
    "src/store.h",
    "src/store_ops.h",
    "src/submit.h",
    "src/platform.h",
    "src/vendor/",
    "binding.gyp",
    "scripts/find_lz4.js",
    "DESIGN.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "gypfile": true,
  "scripts": {
    "install": "node-gyp-build",
    "build": "node-gyp rebuild",
    "test": "node test/run.js",
    "test:types": "tsc -p test/types/tsconfig.json",
    "prebuild": "prebuildify --napi --strip",
    "coverage": "c8 --config .c8rc.json node scripts/coverage.js",
    "coverage:native": "node scripts/coverage-native.js"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "node-gyp": "^10.0.0",
    "prebuildify": "^6.0.1",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "node-gyp-build": "^4.8.4"
  }
}
